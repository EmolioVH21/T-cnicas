#--------------------------------------------------------
# FIGURA EXAM 1
#--------------------------------------------------------

g1 <- ggplot(df,
             aes(x = sex,
                 y = exam1,
                 fill = sex)) +
  
  geom_boxplot(alpha = 0.7) +
  
  geom_jitter(width = 0.1,
              alpha = 0.5) +
  
  labs(title = "Exam 1 by Sex",
       x = "Sex",
       y = "Exam 1 Score") +
  
  theme_minimal()

g1

ggsave("Figuras/boxplot_exam1.png",
       plot = g1,
       width = 6,
       height = 4,
       dpi = 300)

