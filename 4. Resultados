#--------------------------------------------------------
# EXAM 1
#--------------------------------------------------------
g1 <- ggplot(df,
             aes(x = sex,
                 y = exam1,
                 fill = sex)) +
  
  geom_boxplot(alpha = 0.7) +
  
  geom_jitter(width = 0.1,
              alpha = 0.4) +
  
  labs(title = "Exam 1",
       x = "Sex",
       y = "Score") +
  
  theme_minimal()

#--------------------------------------------------------
# EXAM 2
#--------------------------------------------------------
g2 <- ggplot(df,
             aes(x = sex,
                 y = exam2,
                 fill = sex)) +
  
  geom_boxplot(alpha = 0.7) +
  
  geom_jitter(width = 0.1,
              alpha = 0.4) +
  
  labs(title = "Exam 2",
       x = "Sex",
       y = "Score") +
  
  theme_minimal()

#--------------------------------------------------------
# EXAM 3
#--------------------------------------------------------
g3 <- ggplot(df,
             aes(x = sex,
                 y = exam3,
                 fill = sex)) +
  
  geom_boxplot(alpha = 0.7) +
  
  geom_jitter(width = 0.1,
              alpha = 0.4) +
  
  labs(title = "Exam 3",
       x = "Sex",
       y = "Score") +
  
  theme_minimal()

#--------------------------------------------------------
# NOTA FINAL
#--------------------------------------------------------
g4 <- ggplot(df,
             aes(x = sex,
                 y = course_grade,
                 fill = sex)) +
  
  geom_boxplot(alpha = 0.7) +
  
  geom_jitter(width = 0.1,
              alpha = 0.4) +
  
  labs(title = "Final Grade",
       x = "Sex",
       y = "Score") +
  
