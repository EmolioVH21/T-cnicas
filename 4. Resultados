#========================================================
# HIPOTESIS 2
# DIFERENCIAS ENTRE EXAMENES
#========================================================

#--------------------------------------------------------
# BOXPLOT GENERAL
#--------------------------------------------------------
g5 <- ggplot(df_long,
             aes(x = exam,
                 y = score,
                 fill = exam)) +
  
  geom_boxplot(alpha = 0.7) +
  
  geom_jitter(width = 0.1,
              alpha = 0.3) +
  
  labs(title = "Distribution of Scores Across Exams",
       x = "Exam",
       y = "Score") +
  
  theme_minimal()

#--------------------------------------------------------
# GRAFICO DE MEDIAS
#--------------------------------------------------------
g6 <- ggplot(means,
             aes(x = exam,
                 y = mean_score,
                 group = 1)) +
  
  geom_line(linewidth = 1) +
  
  geom_point(size = 3) +
  
  geom_errorbar(aes(ymin = mean_score - se,
                    ymax = mean_score + se),
                width = 0.1) +
  
  labs(title = "Mean Scores Across Exams",
       x = "Exam",
       y = "Mean Score") +
  
  theme_minimal()

#========================================================
# UNIR GRAFICOS HIPOTESIS 2
#========================================================

fig_h2 <- g5 / g6 +
  
  plot_annotation(
    title = "Hypothesis 2: Differences Between Exams"
  )

# Mostrar
fig_h2

# Guardar PNG
ggsave("Figuras/H2_exams.png",
       plot = fig_h2,
       width = 8,
       height = 10,
       dpi = 300)
