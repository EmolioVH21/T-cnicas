#--------------------------------------------------------
# TABLA DESCRIPTIVOS
#--------------------------------------------------------

tabla_h1_desc <- df %>%
  group_by(sex) %>%
  summarise(
    n = n(),
    
    mean_exam1 = mean(exam1, na.rm = TRUE),
    sd_exam1   = sd(exam1, na.rm = TRUE),
    
    mean_exam2 = mean(exam2, na.rm = TRUE),
    sd_exam2   = sd(exam2, na.rm = TRUE),
    
    mean_exam3 = mean(exam3, na.rm = TRUE),
    sd_exam3   = sd(exam3, na.rm = TRUE),
    
    mean_course = mean(course_grade, na.rm = TRUE),
    sd_course   = sd(course_grade, na.rm = TRUE)
  )

#--------------------------------------------------------
# TABLA T TEST
#--------------------------------------------------------

tabla_h1_ttest <- data.frame(
  
  Variable = c(
    "Exam1",
    "Exam2",
    "Exam3",
    "Course_Grade"
  ),
  
  p_value = c(
    t1$p.value,
    t2$p.value,
    t3$p.value,
    t4$p.value
  ),
  
  t_statistic = c(
    t1$statistic,
    t2$statistic,
    t3$statistic,
    t4$statistic
  )
)

