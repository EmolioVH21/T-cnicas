g1 <- ggplot(df,
             aes(x = sex,
                 y = exam1,
                 fill = sex)) +
  
  geom_boxplot(alpha = 0.7) +
  
  geom_jitter(width = 0.1,
              alpha = 0.4) +
  
  labs(title = "Exam 1",
       x = "Sex",
